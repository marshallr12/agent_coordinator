[Unit]
Description=Create and verify an Agent Coordinator backup snapshot
After=local-fs.target
RequiresMountsFor=/var/lib/agent-coordinator /var/lib/agent-coordinator-backups
ConditionPathExists=/var/lib/agent-coordinator/coordinator.sqlite3

[Service]
Type=oneshot
TimeoutStartSec=50min
User=agent-coordinator
Group=agent-coordinator
WorkingDirectory=/var/lib/agent-coordinator-backups
EnvironmentFile=/etc/agent-coordinator/service.env
ExecStart=/usr/local/bin/agent-coordinator-server --database /var/lib/agent-coordinator/coordinator.sqlite3 backup --repository /var/lib/agent-coordinator-backups
StateDirectory=agent-coordinator-backups
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/agent-coordinator
