[Unit]
Description=Upload and download-verify Agent Coordinator snapshots in Cloud Storage
After=network-online.target agent-coordinator-backup.service
Wants=network-online.target
ConditionPathExists=/var/lib/agent-coordinator/coordinator.sqlite3

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStart=/usr/local/sbin/agent-coordinator-backup-transfer
TimeoutStartSec=45min
# The hourly transfer must not starve the service on a 953 MB, one-disk VM
# (see "The hourly transfer on the 1-GB VM" in book/src/docs/backup-restore-guide.md).
Nice=19
CPUWeight=20
IOSchedulingClass=idle
IOWeight=10
# Reclaim the transfer's own pages first instead of the service's page cache.
MemoryHigh=300M
