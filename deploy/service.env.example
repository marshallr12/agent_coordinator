COORDINATOR_DATABASE=/var/lib/agent-coordinator/coordinator.sqlite3
COORDINATOR_LISTEN=127.0.0.1:8080
COORDINATOR_PUBLIC_ORIGIN=https://coordinator.example.com
COORDINATOR_ALLOW_INSECURE_LOOPBACK=false
# Maintenance closes agent sessions idle longer than this many days (0 disables).
# COORDINATOR_SESSION_IDLE_DAYS=7
# Setting TYPESAFE_API_KEY enables TypeSafe reranking of context search results.
# The key is a secret: put it only in /etc/agent-coordinator/typesafe.env
# (root:root 0600), which only the main service unit loads.
