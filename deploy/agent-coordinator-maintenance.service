[Unit]
Description=Compact expired Agent Coordinator replay and redundant health payloads
After=local-fs.target
RequiresMountsFor=/var/lib/agent-coordinator
ConditionPathExists=/var/lib/agent-coordinator/coordinator.sqlite3

[Service]
Type=oneshot
TimeoutStartSec=5min
User=agent-coordinator
Group=agent-coordinator
WorkingDirectory=/var/lib/agent-coordinator
EnvironmentFile=/etc/agent-coordinator/service.env
ExecStart=/usr/local/bin/agent-coordinator-server --database /var/lib/agent-coordinator/coordinator.sqlite3 maintenance --batch-size 500 --max-batches 20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/agent-coordinator
