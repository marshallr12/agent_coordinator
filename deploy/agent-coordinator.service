[Unit]
Description=Agent Coordinator foundation service
After=network.target

[Service]
Type=simple
User=agent-coordinator
Group=agent-coordinator
WorkingDirectory=/var/lib/agent-coordinator
EnvironmentFile=/etc/agent-coordinator/service.env
ExecStart=/usr/local/bin/agent-coordinator-server serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=agent-coordinator
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
