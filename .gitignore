# Rust build and profiling output. Commit Cargo.lock for this application.
**/target/
*.profraw
*.profdata

# Optional frontend dependencies, bundles, and test output.
**/node_modules/
/dist/
/coverage/
/playwright-report/
/test-results/

# Local configuration and credentials. Keep sanitized templates versioned.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
/.claude/settings.local.json
/secrets/
/credentials/

# Runtime state, logs, and backups.
/data/
/state/
/logs/
/backups/
*.log

# SQLite databases and their journal files; SQL migrations remain versioned.
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Local agent worktrees; shared agent guidance and memory remain versioned.
/.worktrees/
/.claude/worktrees/
/.codex/worktrees/

# Editor and operating-system temporary files.
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
